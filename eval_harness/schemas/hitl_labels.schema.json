{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "score_1_to_5",
    "verdict"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "score_1_to_5": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    },
    "comment": {
      "type": "string"
    }
  }
}

